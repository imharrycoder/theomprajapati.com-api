generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id       Int      @id @default(autoincrement())
  slug     String   @unique @db.VarChar(255)
  title    String   @db.VarChar(500)
  excerpt  String   @db.Text
  category String   @db.VarChar(100)
  date     DateTime
  readTime String   @db.VarChar(50)
  author   String   @db.VarChar(100)
  premium  Boolean  @default(false)
  featured Boolean  @default(false)
  tags     String   @db.Text
  content  String   @db.LongText

  @@map("BlogPost")
}

model Service {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(255)
  category      String  @default("") @db.VarChar(100)
  description   String  @db.Text
  displayOnHome Boolean @default(true)

  @@map("Service")
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(500)
  thumbnail   String   @db.VarChar(1000)
  platform    String   @db.VarChar(50)
  videoUrl    String   @unique @db.VarChar(1000)
  description String   @db.Text
  publishDate DateTime
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Video")
}

model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("SiteContent")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  name          String    @db.VarChar(255)
  username      String?   @unique @db.VarChar(50)
  contact       String    @unique @db.VarChar(50)
  instaId       String?   @db.VarChar(255)
  city          String    @db.VarChar(100)
  state         String    @db.VarChar(100)
  profession    String    @db.VarChar(255)
  location      String?   @db.VarChar(255)
  device        String?   @db.VarChar(255)
  token         String?   @unique @db.VarChar(500)
  emailVerified Boolean   @default(false)
  profilePhoto  String?   @db.LongText
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?

  subscriptionPlan      String    @default("NONE") @db.VarChar(50)
  subscriptionExpiresAt DateTime?
  razorpayCustomerId    String?   @db.VarChar(255)
  payments              Payment[]

  @@map("User")
}

model Payment {
  id                Int      @id @default(autoincrement())
  userId            Int
  razorpayOrderId   String   @unique @db.VarChar(255)
  razorpayPaymentId String?  @unique @db.VarChar(255)
  razorpaySignature String?  @db.VarChar(500)
  amount            Int
  currency          String   @default("INR") @db.VarChar(10)
  status            String   @default("CREATED") @db.VarChar(50)
  plan              String   @db.VarChar(50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@map("Payment")
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(100)
  password String @db.VarChar(255)

  @@map("admin_users")
}

model ProjectLead {
  id                Int      @id @default(autoincrement())
  name              String?  @db.VarChar(255)
  email             String?  @db.VarChar(255)
  phone             String?  @db.VarChar(50)
  company           String?  @db.VarChar(255)
  servicesSelected  String   @db.LongText
  aiQuestions       String   @db.LongText
  aiAnswers         String   @db.LongText
  aiSummary         String?  @db.LongText
  aiConversationLog String?  @db.LongText
  complexity        String   @db.VarChar(50)
  estimatedTimeline String   @db.LongText
  developerCost     Int
  thirdPartyCost    Int
  recurringCost     Int      @default(0)
  totalCost         Int
  deliverables      String   @db.LongText
  recommendations   String?  @db.LongText
  whatsappClicked   Boolean  @default(false)
  pdfDownloaded     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ProjectLead")
}
